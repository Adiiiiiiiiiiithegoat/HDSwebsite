# Build assets resolve to themselves and stop here. First match wins, so this
# keeps /assets/* from ever reaching the SPA catch-all below.
#
# Without it, an asset request that misses (a hash not yet live at an edge
# during a deploy) fell through to index.html and came back as 200 text/html —
# which _headers then stamped `immutable, max-age=31536000`. The edge and the
# browser cached an HTML document under a .css/.js URL for a year, so the page
# rendered with no stylesheet, or no script at all, for whoever hit that node.
/assets/*  /assets/:splat  200

# SPA: every other path serves index.html and react-router takes over.
/*  /index.html  200
